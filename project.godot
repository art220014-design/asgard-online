; Engine configuration file.
; Asgard Online — мобильная MMORPG в духе классических корейских RPG.

config_version=5

[application]

config/name="Asgard Online"
config/description="Мобильная RPG с выделенным сервером"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icons/sword.png"
boot_splash/bg_color=Color(0.07, 0.09, 0.12, 1)
boot_splash/show_image=false

[autoload]

GameData="*res://scripts/game_data.gd"
Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.1, 0.14, 0.1, 1)

[network]

limits/debugger/max_queued_messages=2048
